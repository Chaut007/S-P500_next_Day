# Virtual environment
.venv/
venv/
env/

# Secrets
.env

# Downloaded and derived data.
# Large and fully reproducible from `python -m scripts.run_data`.
# mcap_daily.parquet alone is ~10 MB.
data/raw/*
data/interim/*
data/processed/*
