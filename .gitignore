# Virtual environment
.venv/
venv/
env/

# Secrets
.env

# Downloaded and derived data.
# Large and fully reproducible from `python -m scripts.run_data`.
# mcap_daily.parquet alone is ~10 MB.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Exception: the CSV exports from notebooks/02_modelling.ipynb. They are the
# study's data in a form anyone can open without Python, they total under 3 MB,
# and they are cited in the report -- the same reason reports/*.parquet is kept.
# The parquet tables beside them stay ignored; mcap_daily.parquet alone is 10 MB
# and is rebuilt by `python -m scripts.run_data`.
!data/processed/top10_ranking_daily.csv
!data/processed/close_prices_top10.csv
!data/processed/index_close.csv

# Trained models. AutoGluon writes a directory tree per fold.
models/*
!models/.gitkeep

logs/*
!logs/.gitkeep

reports/figures/*
!reports/figures/.gitkeep

# Kept in version control on purpose:
#   reports/*.parquet   -- the numbers quoted in README.md (~170 KB total)
#   assets/*.mp4        -- the dashboard home-page animation (~830 KB)

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
